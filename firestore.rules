rules_version = '2';
// Pravila za Firestore bazu. Kopiraju se u Firebase konzolu: Firestore Database -> Rules -> Publish.
// PRIJE KOPIRANJA: upiši email vlasnika salona (isti kao emailVlasnika u postavke.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function prijavljen() { return request.auth != null; }
    function vlasnik() { return prijavljen() && request.auth.token.email == 'bornapavicic85@gmail.com'; }
    function dobarTel(t) { return t is string && t.matches('^(09[1-9][0-9]{6,7}|[+][1-9][0-9]{7,14})$'); }
    function dobroIme(i) { return i is string && i.size() >= 2 && i.size() <= 50; }
    function put(kolekcija, id) { return /databases/$(database)/documents/$(kolekcija)/$(id); }
    // Vrijeme termina (hrvatsko zimsko vrijeme, UTC+1; ljeti je pravilo 1 sat blaže)
    function kada(d) {
      return timestamp.date(int(d.datum.split('-')[0]), int(d.datum.split('-')[1]), int(d.datum.split('-')[2]))
        + duration.value(int(d.vrijeme.split(':')[0]) * 60 + int(d.vrijeme.split(':')[1]) - 60, 'm');
    }
    function neplacen(d) { return d.get('nijeDosao', false) == true && d.get('podmireno', false) != true; }

    // Zauzeti sati (bez osobnih podataka) – nastaju samo zajedno s terminom
    match /slots/{id} {
      allow read: if prijavljen();
      allow create: if prijavljen()
        && request.resource.data.keys().hasOnly(['datum', 'vrijeme'])
        && id == request.resource.data.datum + '_' + request.resource.data.vrijeme
        && existsAfter(put('termini', id));
      allow delete: if vlasnik()
        || (prijavljen() && get(put('termini', id)).data.uid == request.auth.uid);
    }

    // Oznaka {uid}_{datum}: jedna osoba može imati najviše jedan termin u danu (koristi se samo ako je uključeno u postavke.js)
    match /dnevno/{id} {
      allow create: if prijavljen()
        && request.resource.data.keys().hasOnly(['uid', 'datum'])
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.datum;
      allow delete: if vlasnik() || (prijavljen() && id.matches('^' + request.auth.uid + '_.*'));
    }

    // Termini: vidi ih vlasnik salona i klijent; vlasnik smije samo označiti "nije došao" / "platio".
    // Kasno otkazan termin (manje od 8 sati prije) seli se u termini/{id}_k i plaća se kao propušteni.
    match /termini/{id} {
      allow read: if vlasnik() || (prijavljen() && resource.data.uid == request.auth.uid);
      allow create: if prijavljen()
        && request.resource.data.keys().hasOnly(['ime', 'tel', 'usluga', 'datum', 'vrijeme', 'napomena', 'created', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.datum + '_' + request.resource.data.vrijeme
        && request.resource.data.datum.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.vrijeme.matches('^[0-9]{2}:[0-9]{2}$')
        && dobroIme(request.resource.data.ime)
        && dobarTel(request.resource.data.tel)
        && request.resource.data.usluga is string && request.resource.data.usluga.size() <= 60
        && request.resource.data.napomena is string && request.resource.data.napomena.size() <= 500
        && request.resource.data.created == request.time
        && existsAfter(put('slots', id));
      allow create: if prijavljen()
        && id == request.resource.data.datum + '_' + request.resource.data.vrijeme + '_k'
        && get(put('termini', request.resource.data.datum + '_' + request.resource.data.vrijeme)).data.uid == request.auth.uid
        && !existsAfter(put('termini', request.resource.data.datum + '_' + request.resource.data.vrijeme))
        && request.resource.data.diff(get(put('termini', request.resource.data.datum + '_' + request.resource.data.vrijeme)).data)
             .affectedKeys().hasOnly(['otkazanKasno', 'nijeDosao', 'podmireno'])
        && request.resource.data.otkazanKasno == true
        && request.resource.data.nijeDosao == true
        && request.resource.data.podmireno == false;
      // Vlasnik sam upisuje termin (klijent je nazvao): bez računa klijenta, mobitel nije obavezan
      allow create: if vlasnik()
        && request.resource.data.keys().hasOnly(['ime', 'tel', 'usluga', 'datum', 'vrijeme', 'napomena', 'created', 'rucno'])
        && request.resource.data.rucno == true
        && id == request.resource.data.datum + '_' + request.resource.data.vrijeme
        && request.resource.data.datum.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.vrijeme.matches('^[0-9]{2}:[0-9]{2}$')
        && dobroIme(request.resource.data.ime)
        && (request.resource.data.tel == '' || dobarTel(request.resource.data.tel))
        && request.resource.data.usluga is string && request.resource.data.usluga.size() <= 60
        && request.resource.data.napomena is string && request.resource.data.napomena.size() <= 500
        && request.resource.data.created == request.time
        && existsAfter(put('slots', id));
      allow update: if vlasnik()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nijeDosao', 'podmireno']);
      // Klijent promijeni ime/mobitel u profilu -> ažurira se i u njegovim zakazanim terminima
      allow update: if prijavljen() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ime', 'tel'])
        && dobroIme(request.resource.data.ime)
        && dobarTel(request.resource.data.tel);
      // Klijent briše svoj termin: ne ako duguje za njega; manje od 8 sati prije samo kao kasni otkaz (_k);
      // prošle termine tek 2 dana kasnije (da salon stigne označiti "nije došao")
      allow delete: if vlasnik()
        || (prijavljen() && resource.data.uid == request.auth.uid && !neplacen(resource.data)
            && (kada(resource.data) > request.time + duration.value(8, 'h')
                || kada(resource.data) < request.time - duration.value(2, 'd')
                || resource.data.get('otkazanKasno', false) == true
                || existsAfter(put('termini', id + '_k'))));
    }

    // Postavke salona (usluge, cijene, radno vrijeme, neradni dani, kontakt) – čita svatko, mijenja samo vlasnik salona
    match /postavke/{id} {
      allow read: if true;
      allow write: if vlasnik() && id == 'salon'
        && request.resource.data.keys().hasOnly(['naziv', 'telefon', 'adresa', 'instagram', 'radnoVrijeme', 'blagdani', 'neradniDani', 'usluge'])
        && request.resource.data.naziv is string && request.resource.data.naziv.size() <= 40
        && request.resource.data.telefon is string && request.resource.data.telefon.size() <= 30
        && request.resource.data.adresa is string && request.resource.data.adresa.size() <= 80
        && request.resource.data.instagram is string && request.resource.data.instagram.size() <= 40
        && request.resource.data.radnoVrijeme is map
        && request.resource.data.blagdani is bool
        && request.resource.data.neradniDani is list && request.resource.data.neradniDani.size() <= 400
        && request.resource.data.usluge is list && request.resource.data.usluge.size() <= 60;
    }

    // Osobni podaci klijenta – samo vlasnik
    match /korisnici/{uid} {
      allow read, delete: if prijavljen() && request.auth.uid == uid;
      allow create, update: if prijavljen() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ime', 'tel'])
        && dobroIme(request.resource.data.ime)
        && dobarTel(request.resource.data.tel);
    }
  }
}
